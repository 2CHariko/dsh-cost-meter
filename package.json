{
  "name": "dsh-cost-meter",
  "version": "0.5.2",
  "description": "Session spend for the DSH Web client: a composer-dock pill that prices provider-reported token usage with live DeepSeek CNY/USD peak/off-peak prices and its own settings page.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "cost",
    "tokens",
    "web"
  ],
  "license": "MIT",
  "author": "2CHariko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2CHariko/dsh-cost-meter.git"
  },
  "homepage": "https://github.com/2CHariko/dsh-cost-meter#readme",
  "bugs": {
    "url": "https://github.com/2CHariko/dsh-cost-meter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/catalog.js && node --check lib/period-usage.js && node --check lib/history.js",
    "test": "node test/catalog.mjs && node test/period-usage.mjs && node test/history.mjs && node test/smoke.mjs",
    "test:install": "node test/verify-install.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ]
}
